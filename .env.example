# ==============================================================================
# AWS SBG LPU Certificate Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and configure your environment variables:
#   cp .env.example .env.local
# DO NOT commit .env.local to source control!

# ------------------------------------------------------------------------------
# 1. Supabase Backend Configuration
# ------------------------------------------------------------------------------
# URL of your Supabase instance
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anonymous key (safe for client-side use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role secret key (KEEP SECRET! Used only by server-side actions/API)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional publishable client key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# 2. Site Configuration
# ------------------------------------------------------------------------------
# Canonical base URL for QR codes, verification links, and OpenGraph metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. LinkedIn Integration
# ------------------------------------------------------------------------------
# Official LinkedIn Organization ID for AWS Student Builder Group at LPU
# (Default: 69826209)
LINKEDIN_ORG_ID=69826209
NEXT_PUBLIC_LINKEDIN_ORG_ID=69826209

# ------------------------------------------------------------------------------
# 4. Observability & Monitoring (Optional)
# ------------------------------------------------------------------------------
# Sentry DSN for error reporting in production
# SENTRY_DSN=
